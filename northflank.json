{
  "apiVersion": "v1.2",
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "ref": "project",
          "kind": "Project",
          "spec": {
            "name": "Sunday-${args.id}",
            "description": "N8N SaaS Instance with Neon Database v2",
            "color": "#ea4b70",
            "networking": {
              "allowedIngressProjects": [],
              "hostAliases": {
                "enabled": false
              }
            },
            "region": "asia-southeast"
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "context": {
              "projectId": "${refs.project.id}"
            },
            "type": "sequential",
            "steps": [
              {
                "ref": "database",
                "kind": "Addon",
                "spec": {
                  "name": "database",
                  "infrastructure": {
                    "architecture": "x86"
                  },
                  "type": "postgresql",
                  "version": "16",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "storageClass": "ssd",
                    "storage": 4096,
                    "replicas": 1
                  },
                  "tlsEnabled": true,
                  "externalAccessEnabled": true,
                  "typeSpecificSettings": {
                    "postgresqlConnectionPoolerReplicas": 2,
                    "postgresqlReadConnectionPoolerReplicas": 2
                  }
                }
              },
              {
                "kind": "Condition",
                "spec": {
                  "kind": "Addon",
                  "spec": {
                    "data": {
                      "addonId": "${refs.database.id}"
                    },
                    "type": "running"
                  }
                }
              },
              {
                "ref": "n8n-secrets-base",
                "kind": "SecretGroup",
                "spec": {
                  "type": "secret",
                  "secretType": "environment-arguments",
                  "priority": 10,
                  "name": "n8n-secrets-base",
                  "addonDependencies": [
                    {
                      "addonId": "${refs.database.id}",
                      "keys": [
                        {
                          "keyName": "HOST",
                          "aliases": []
                        },
                        {
                          "keyName": "POSTGRES_URI",
                          "aliases": []
                        },
                        {
                          "keyName": "USERNAME",
                          "aliases": []
                        },
                        {
                          "keyName": "PASSWORD",
                          "aliases": []
                        },
                        {
                          "keyName": "DATABASE",
                          "aliases": []
                        },
                        {
                          "keyName": "EXTERNAL_POSTGRES_URI",
                          "aliases": []
                        },
                        {
                          "keyName": "EXTERNAL_PORT_PRIMARY",
                          "aliases": []
                        },
                        {
                          "keyName": "EXTERNAL_POSTGRES_URI_ADMIN",
                          "aliases": []
                        },
                        {
                          "keyName": "EXTERNAL_JDBC_POSTGRES_URI",
                          "aliases": []
                        },
                        {
                          "keyName": "EXTERNAL_JDBC_POSTGRES_URI_ADMIN",
                          "aliases": []
                        }
                      ]
                    }
                  ],
                  "secrets": {
                    "variables": {
                      "DB_TYPE": "postgresdb",
                      "DB_POSTGRESDB_SSL": "true",
                      "N8N_ENCRYPTION_KEY": "${args.N8N_ENCRYPTION_KEY}",
                      "N8N_USER_MANAGEMENT_JWT_SECRET": "${args.N8N_ENCRYPTION_KEY}",
                      "N8N_USER_MANAGEMENT_DISABLED": "false",
                      "N8N_RUNNERS_ENABLED": "true",
                      "N8N_RUNNERS_MODE": "internal",
                      "N8N_PROXY_HOPS": "1",
                      "N8N_DIAGNOSTICS_ENABLED": "false",
                      "N8N_PERSONALIZATION_ENABLED": "false",
                      "TINI_SUBREAPER": "1"
                    },
                    "files": {},
                    "dockerSecretMounts": {}
                  },
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": []
                  }
                }
              },
              {
                "ref": "n8n",
                "kind": "DeploymentService",
                "spec": {
                  "deployment": {
                    "instances": 1,
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 1024
                      },
                      "shmSize": 64
                    },
                    "docker": {
                      "configType": "default"
                    },
                    "type": "deployment",
                    "external": {
                      "imagePath": "docker.n8n.io/n8nio/n8n:latest"
                    },
                    "metadata": {
                      "labels": {},
                      "annotations": {}
                    }
                  },
                  "loadBalancing": {
                    "mode": "leastConnection"
                  },
                  "name": "n8n",
                  "infrastructure": {
                    "architecture": "x86"
                  },
                  "billing": {
                    "deploymentPlan": "nf-compute-100-2"
                  },
                  "autoscaling": {
                    "horizontal": {
                      "enabled": true,
                      "minReplicas": 1,
                      "maxReplicas": 3,
                      "cpu": {
                        "enabled": true,
                        "thresholdPercentage": 80
                      },
                      "memory": {
                        "enabled": true,
                        "thresholdPercentage": 80
                      }
                    }
                  },
                  "ports": [
                    {
                      "name": "sun",
                      "internalPort": 5678,
                      "protocol": "HTTP",
                      "public": true,
                      "security": {
                        "credentials": [],
                        "policies": [],
                        "sso": {}
                      }
                    }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "startupProbe",
                      "port": 5678,
                      "path": "/healthz",
                      "initialDelaySeconds": 30,
                      "periodSeconds": 15,
                      "timeoutSeconds": 10,
                      "failureThreshold": 10
                    },
                    {
                      "protocol": "HTTP",
                      "type": "livenessProbe",
                      "port": 5678,
                      "path": "/healthz",
                      "initialDelaySeconds": 30,
                      "periodSeconds": 60,
                      "timeoutSeconds": 10,
                      "failureThreshold": 3
                    },
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "port": 5678,
                      "path": "/healthz/readiness",
                      "initialDelaySeconds": 30,
                      "periodSeconds": 60,
                      "timeoutSeconds": 10,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ],
                  "runtimeEnvironment": {
                    "secretGroups": "n8n-secrets-base,setup-secrets",
                    "DB_POSTGRESDB_CONNECTION_STRING": "${NF_DATABASE_EXTERNAL_POSTGRES_URI}"
                  },
                  "runtimeFiles": {}
                }
              },
              {
                "kind": "Condition",
                "spec": {
                  "kind": "Service",
                  "spec": {
                    "data": {
                      "serviceId": "${refs.n8n.id}"
                    },
                    "type": "running"
                  }
                }
              },
              {
                "ref": "setup-secrets",
                "kind": "SecretGroup",
                "spec": {
                  "type": "secret",
                  "secretType": "environment-arguments",
                  "priority": 10,
                  "name": "setup-secrets",
                  "secrets": {
                    "variables": {
                      "N8N_HOST": "${refs.n8n.ports.0.dns}",
                      "N8N_EDITOR_BASE_URL": "https://${refs.n8n.ports.0.dns}",
                      "WEBHOOK_URL": "https://${refs.n8n.ports.0.dns}",
                      "N8N_ENCRYPTION_KEY": "${args.N8N_ENCRYPTION_KEY}",
                      "N8N_FIRST_NAME": "${args.user_name}",
                      "N8N_LAST_NAME": "${args.user_name}",
                      "N8N_USER_EMAIL": "${args.user_email}",
                      "N8N_USER_PASSWORD": "7On${args.N8N_ENCRYPTION_KEY}",
                      "N8N_USER_ID": "${args.user_id}",
                      "USER_ID": "${args.user_id}",
                      "CLERK_USER_ID": "${args.clerk_user_id}",
                      "USER_EMAIL": "${args.user_email}",
                      "DATABASE_URL": "${args.neon_database_url}",
                      "DB_TYPE": "postgresdb",
                      "DB_POSTGRESDB_SSL": "true",
                      "N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS": "true",
                      "NORTHFLANK_PROJECT_ID": "${refs.project.id}",
                      "NORTHFLANK_PROJECT_NAME": "${refs.project.name}",
                      "WORKFLOW_TEMPLATES": "default"
                    },
                    "files": {},
                    "dockerSecretMounts": {}
                  },
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": []
                  }
                }
              },
              {
                "ref": "n8n-setup-job",
                "kind": "Job",
                "spec": {
                  "name": "n8n-setup-complete",
                  "infrastructure": {
                    "architecture": "x86"
                  },
                  "billing": {
                    "deploymentPlan": "nf-compute-20"
                  },
                  "deployment": {
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 1024
                      },
                      "shmSize": 64
                    },
                    "docker": {
                      "configType": "default"
                    },
                    "external": {
                      "imagePath": "ghcr.io/7on-ai/7on-n8n:latest"
                    }
                  },
                  "runtimeEnvironment": {
                    "secretGroups": "setup-secrets"
                  },
                  "settings": {
                    "backoffLimit": 3,
                    "activeDeadlineSeconds": 600,
                    "runOnSourceChange": "never"
                  },
                  "buildConfiguration": {
                    "pathIgnoreRules": [],
                    "isAllowList": false,
                    "ciIgnoreFlagsEnabled": false
                  },
                  "buildArguments": {}
                }
              },
              {
                "kind": "JobRun",
                "spec": {
                  "jobId": "${refs.n8n-setup-job.id}"
                },
                "condition": "success",
                "ref": "n8n-setup-jobrun"
              }
            ]
          }
        }
      ]
    }
  },
  "arguments": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the project",
      "required": true
    },
    "clerk_user_id": {
      "type": "string",
      "description": "Clerk User ID (e.g., user_xxxxx)",
      "required": true,
      "validation": {
        "pattern": "^user_[a-zA-Z0-9]+$"
      }
    },
    "user_id": {
      "type": "string",
      "description": "User ID from your application",
      "required": true
    },
    "user_name": {
      "type": "string",
      "description": "User's name for N8N setup",
      "required": true
    },
    "user_email": {
      "type": "string",
      "description": "User's email for N8N login",
      "required": true,
      "validation": {
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      }
    },
    "N8N_ENCRYPTION_KEY": {
      "type": "string",
      "description": "N8N encryption key (min 32 characters)",
      "required": true,
      "sensitive": true,
      "validation": {
        "minLength": 32
      }
    },
    "neon_database_url": {
      "type": "string",
      "description": "Neon PostgreSQL connection string",
      "required": true,
      "sensitive": true,
      "validation": {
        "pattern": "^postgresql://.+"
      }
    }
  },
  "name": "Sunday",
  "description": "Infra-n8n Latest Version & n8n-setup ",
  "options": {
    "autorun": false,
    "concurrencyPolicy": "allow",
    "runOnUpdate": false
  },
  "gitops": {
    "repoUrl": "https://github.com/7on-ai/n8n-store-credentials",
    "vcsService": "github",
    "accountLogin": "7on-ai",
    "branch": "main",
    "filePath": "/northflank.json"
  },
  "$schema": "https://api.northflank.com/v1/schemas/template"
}